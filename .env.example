# URL publica desta aplicacao. E o que a tela de Conexao mostra como URL de webhook.
# Em dev, use o host do ngrok apontando pra porta 3031 (frontend, que faz proxy do /webhook).
PUBLIC_BASE_URL=http://localhost:3031

# --- Evolution API (canal padrao; tambem editavel pela UI) ---
# Servem de base pra novas linhas: cada linha pode ter URL/apikey propria.
# Com a Evolution no compose vizinho (Teste/evolution), use o hostname interno
# da rede evolution-net e a porta de DENTRO do container:
#   EVOLUTION_BASE_URL=http://evolution-api:8080
# Nao use a porta publicada no host (8083) nem host.docker.internal — isso so
# vale pra uma Evolution que rode fora do Docker.
# ATENCAO: isto e so o default de novas instalacoes. Se a URL ja foi salva pela
# tela de Configuracoes, ela mora no banco e vence este arquivo (settings_store.py).
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=

# --- Login do painel (JWT) ---
# Chave que assina os tokens. OBRIGATORIA em producao: sem ela o backend sorteia
# uma a cada subida e todo mundo cai do login no restart. Gere a sua com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Validade do token de acesso (o painel renova sozinho pelo refresh) e do refresh.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
# Trava de forca bruta no /api/auth/login, por IP + usuario.
LOGIN_MAX_FAILS=8
LOGIN_FAIL_WINDOW_SECONDS=300

# Primeiro admin, criado sozinho quando a base ainda nao tem nenhum usuario.
# Depois disso o cadastro vive no painel (Admin -> Usuarios) e estas duas
# variaveis nao valem mais nada. TROQUE A SENHA: o default esta no README.
ADMIN_USER=gabriel
ADMIN_PASSWORD=gabriel123

# --- WhatsApp Cloud API (canal legado, so na area de admin) ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_VERIFY_TOKEN=brandcast-verify
WA_APP_SECRET=
GRAPH_VERSION=v21.0

# --- Meta Conversions API ---
META_DATASET_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# --- Google Ads (conversoes offline) ---
GOOGLE_CUSTOMER_ID=
GOOGLE_LOGIN_CUSTOMER_ID=
GOOGLE_CONVERSION_ACTION_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_ADS_VERSION=v18

# --- Webhook de saida ---
OUT_WEBHOOK_URL=
OUT_WEBHOOK_SECRET=

CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Apify (varredura de potenciais clientes no Google Maps) ---
APIFY_TOKEN=
APIFY_ACTOR=compass/crawler-google-places
PROSPECT_LANGUAGE=pt-BR
PROSPECT_DEFAULT_RADIUS_KM=5
PROSPECT_MAX_PER_TERM=60

# --- Abordagem ativa no WhatsApp ---
# Nome do template aprovado usado na abordagem fria (fora da janela de 24h).
OUTREACH_TEMPLATE_NAME=
OUTREACH_TEMPLATE_LANGUAGE=pt_BR
OUTREACH_THROTTLE_SECONDS=8
OUTREACH_DAILY_CAP=80
