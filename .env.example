# URL publica desta aplicacao. E o que a tela de Conexao mostra como URL de webhook.
# Em dev, use o host do ngrok apontando pra porta 8030 (frontend, que faz proxy do /webhook).
PUBLIC_BASE_URL=http://localhost:8030

# --- Evolution API (canal padrao; tambem editavel pela UI) ---
# Servem de base pra novas linhas: cada linha pode ter URL/apikey propria.
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=

# --- Area de admin (prospeccao, CRM, Cloud API, destinos extras) ---
# TROQUE A SENHA antes de expor na internet: o default esta no README, e publico.
ADMIN_USER=gabriel
ADMIN_PASSWORD=gabriel123
# Chave que assina o token de sessao (nunca derivada da senha). Em branco, e sorteada
# a cada subida do backend — seguro, mas a sessao cai no restart. Gere uma com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SECRET=
ADMIN_SESSION_HOURS=12

# --- WhatsApp Cloud API (canal legado, so na area de admin) ---
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_VERIFY_TOKEN=brandcast-verify
WA_APP_SECRET=
GRAPH_VERSION=v21.0

# --- Meta Conversions API ---
META_DATASET_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# --- Google Ads (conversoes offline) ---
GOOGLE_CUSTOMER_ID=
GOOGLE_LOGIN_CUSTOMER_ID=
GOOGLE_CONVERSION_ACTION_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DEVELOPER_TOKEN=
GOOGLE_ADS_VERSION=v18

# --- Webhook de saida ---
OUT_WEBHOOK_URL=
OUT_WEBHOOK_SECRET=

CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Apify (varredura de potenciais clientes no Google Maps) ---
APIFY_TOKEN=
APIFY_ACTOR=compass/crawler-google-places
PROSPECT_LANGUAGE=pt-BR
PROSPECT_DEFAULT_RADIUS_KM=5
PROSPECT_MAX_PER_TERM=60

# --- Abordagem ativa no WhatsApp ---
# Nome do template aprovado usado na abordagem fria (fora da janela de 24h).
OUTREACH_TEMPLATE_NAME=
OUTREACH_TEMPLATE_LANGUAGE=pt_BR
OUTREACH_THROTTLE_SECONDS=8
OUTREACH_DAILY_CAP=80
